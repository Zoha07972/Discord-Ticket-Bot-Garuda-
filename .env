# Discord bot token — create a separate bot application/token for this ticket bot.
DISCORD_BOT_TOKEN=

# IDs for the server's ticket configuration
ALLOWED_CHANNEL_ID=123456789012345678
TICKET_MESSAGE_CHANNEL_ID=123456789012345678
TICKET_LOG_CHANNEL_ID=123456789012345678
SUPPORT_ROLE_ID=123456789012345678
SALES_ROLE_ID=123456789012345678
NETWORK_ROLE_ID=123456789012345678
GARUDA_ROLE_ID=123456789012345678

# MySQL database containing the tickets and ticket_counter tables
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Logging
LOG_LEVEL=INFO
LOGGER_NAME=garudacloud.ticketbot
LOG_DIR=logs
DATABASE_BACKUP_FOLDER=./ticket_backups
LOGO_PATH=./images/garuda_logo.webp
